# Copy to .env and adjust. Every variable from docs/specs/infra/02-env-ci-and-probes.md is listed here (F-INFRA-05).
# .env is gitignored — never commit real values. Only POSTGRES_PASSWORD is secret.

# --- Compose namespace & wave port block (infra/01#per-wave-port-blocks) -------------------------
# Wave wNN previews use COMPOSE_PROJECT_NAME=insta-<wNN> and WAVE_PORT_BASE=18000+NN*10.
COMPOSE_PROJECT_NAME=insta
WAVE_PORT_BASE=18000
# WAVE_PORT_BASE + 0 / +1 / +2 (+3..+9 reserved)
WEB_HOST_PORT=18000
API_HOST_PORT=18001
# Only published by docker-compose.dev.yml, never in previews
DB_HOST_PORT=18002

# --- Public origins (required) -------------------------------------------------------------------
PUBLIC_URL=http://localhost:18000
PUBLIC_API_URL=http://localhost:18001
# Comma-separated allowed origins; normally = PUBLIC_URL
CORS_ORIGIN=http://localhost:18000

# --- PostgreSQL ----------------------------------------------------------------------------------
POSTGRES_DB=insta
POSTGRES_USER=insta
# SECRET: replace with a random value (e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=change-me

# --- API -----------------------------------------------------------------------------------------
# Built by docker-compose.yml inside the stack; set it only when running the API on the host
# (npm run dev / npm run test:integration) against the dev-override DB on DB_HOST_PORT.
DATABASE_URL=postgres://insta:change-me@localhost:18002/insta
# Listen port inside the container / on the host for `npm run dev`
API_PORT=3000
# Media volume root (compose mounts the `media` volume here); use e.g. ./data/media for host dev
MEDIA_DIR=/data/media
MIGRATE_ON_START=true
JOBS_ENABLED=true
SESSION_TTL_DAYS=30
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# off | strict (strict validates responses against @insta/contracts; tests use strict)
RESPONSE_VALIDATION=off
# Reported by GET /api/v1/health
GIT_SHA=dev
