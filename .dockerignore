# Build context is the repo root for both images (apps/api/Dockerfile, apps/web/Dockerfile).
# Keep host artifacts out so `npm ci` and `tsc -b` inside the image start clean.
.git
.github
.agents
.yardos
docs
**/node_modules
**/dist
**/build
**/coverage
**/*.tsbuildinfo
**/.vite
**/playwright-report
**/test-results
data
*.log

# secrets & local env (never baked into images)
.env
.env.*
!.env.example

# compose files are not needed inside images
docker-compose*.yml
