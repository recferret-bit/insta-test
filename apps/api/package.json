{
  "name": "@insta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/data/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.0",
    "@insta/contracts": "*",
    "argon2": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^4.0.2",
    "file-type": "^21.0.0",
    "image-size": "^2.0.2",
    "pg": "^8.16.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "vitest": "^2.1.9"
  }
}
