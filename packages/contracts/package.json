{
  "name": "@insta/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared wire contracts (Zod DTO schemas, error codes, IDs, SSE events) for apps/api and apps/web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
